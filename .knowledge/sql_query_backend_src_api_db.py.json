{"is_source_file": true, "format": "Python", "description": "This file provides a database abstraction layer supporting both PostgreSQL and SQLite. It includes functions for reading database URLs from environment variables or files, establishing read-only database connections, executing read-only queries, and handling URL parsing and connection setup with considerations for transaction isolation and timeout settings.", "external_files": ["os", "re", "sqlite3", "contextlib", "dataclasses", "typing", "psycopg2", "psycopg2.extras"], "external_methods": ["psycopg2.connect", "psycopg2.extras.RealDictCursor"], "published": ["execute_readonly_query", "execute_query"], "classes": [{"name": "ParsedDBUrl", "description": "A data class representing the parsed components of a database URL, including the scheme ('postgresql' or 'sqlite') and the full URL."}], "methods": [{"name": "Optional[str] _read_fallback_db_url_from_file()", "description": "Reads the database connection URL from 'db_connection.txt' if it exists, extracting the URL after known CLI tokens or returning the entire content if it appears to be a URL.", "scope": "", "scopeKind": ""}, {"name": "str _get_db_url()", "description": "Resolves the database URL primarily from the environment variable 'DB_URL' or fallback file; defaults to in-memory SQLite if neither is available.", "scope": "", "scopeKind": ""}, {"name": "ParsedDBUrl _parse_db_url(url: str)", "description": "Parses a database URL string to determine its scheme ('postgresql' or 'sqlite') and returns a structured representation.", "scope": "", "scopeKind": ""}, {"name": "_pg_connection_ro(dsn: str)", "description": "Provides a context manager for establishing a PostgreSQL read-only connection with optional statement timeout.", "scope": "", "scopeKind": ""}, {"name": "_sqlite_connection_ro(url: str)", "description": "Provides a context manager for establishing a read-only SQLite connection for either in-memory or file-based databases.", "scope": "", "scopeK