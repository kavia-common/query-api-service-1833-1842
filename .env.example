# Application configuration for sql_query_backend

# The database connection URL.
# Supported:
# - PostgreSQL: postgresql://user:password@host:5432/database
# - SQLite file: sqlite:////absolute/path/to/database.db
# - SQLite memory: sqlite:///:memory:
DB_URL=postgresql://user:password@localhost:5432/mydb

# Port for the FastAPI server (used by your process manager or run command)
APP_PORT=3001

# Optional: per-transaction timeout for PostgreSQL in milliseconds to avoid long-running queries
# Uncomment and set to an integer (e.g., 5000 for 5 seconds)
# DB_STATEMENT_TIMEOUT_MS=5000
