# Application port (used when starting uvicorn manually or by a process manager)
APP_PORT=3001

# Database URL:
# - For PostgreSQL (requires psycopg2-binary installed in the environment):
#   DB_URL=postgresql://user:pass@host:5432/database
# - For SQLite (no extra driver needed):
#   DB_URL=sqlite:////absolute/path/to/app.db
# - In-memory SQLite (ephemeral):
#   DB_URL=sqlite:///:memory:
DB_URL=

# PostgreSQL optional per-transaction statement timeout (milliseconds)
# Only applicable when DB_URL uses postgresql://
# Example: DB_STATEMENT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=
